generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         Int                @id @default(autoincrement())
  email                      String             @unique
  password                   String
  created_at                 DateTime           @default(now())
  updated_at                 DateTime           @updatedAt
  email_verification_expires DateTime?
  email_verification_token   String?            @unique
  email_verified             Boolean            @default(false)
  password_reset_token       String?            @unique
  password_reset_expires     DateTime?
  role_id                    Int?
  contentRecipients          ContentRecipient[]
  events                     Event[]
  profile                    Profile?
  questions                  Question[]         @relation("CreatedQuestions")
  role                       Role?              @relation(fields: [role_id], references: [id])
}

model Profile {
  id              Int           @id @default(autoincrement())
  user_id         Int           @unique
  first_name      String
  last_name       String
  phone           String?
  organization_id Int?
  profile_image   String?
  role_id         Int           @default(4)
  organization    Organization? @relation(fields: [organization_id], references: [id])
  role            Role          @relation(fields: [role_id], references: [id])
  user            User          @relation(fields: [user_id], references: [id])
}

model School {
  id              Int           @id @default(autoincrement())
  name            String
  address         String
  phone           String
  description     String?
  email           String        @unique
  image           String?
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  organization_id Int
  organization    Organization  @relation(fields: [organization_id], references: [id])
}


model Organization {
  id                    Int             @id @default(autoincrement())
  name                  String
  address               String
  is_trust              Boolean         @default(false)
  selected_school_count Int?            
  subscription_status   String?
  subscription_id       Int?
  last_purchase         DateTime?
  subscription          Subscription?   @relation(fields: [subscription_id], references: [id])
  profiles              Profile[]
  payments              Payment[]
  trust_locked          Boolean   @default(false)
  schools               School[]        
}


model Subscription {
  id            Int            @id @default(autoincrement())
  package_name  String
  cost          Float
  validity      Int
  organizations Organization[]
}

model Payment {
  id              Int           @id @default(autoincrement())
  organization_id Int
  amount          Float
  currency        String        @default("USD")
  status          String        @default("pending")
  description     String?
  created_at      DateTime      @default(now())
  organization    Organization  @relation(fields: [organization_id], references: [id])
}

model Role {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  profiles Profile[]
  users    User[]
}

model Event {
  id          Int       @id @default(autoincrement())
  time_span   Int
  name        String
  type        String?
  date_time   DateTime
  description String?
  user_id     Int
  image       String?
  contents    Content[]
  user        User      @relation(fields: [user_id], references: [id])
}

model Content {
  id                 Int                @id @default(autoincrement())
  event_id           Int
  content_type       String
  text_content       String
  attachment         String?
  event              Event              @relation(fields: [event_id], references: [id])
  content_recipients ContentRecipient[]
  created_at         DateTime           @default(now())
  updated_at         DateTime           @default(now()) @updatedAt
}

model PostMethod {
  id                 Int                @id @default(autoincrement())
  name               String             @unique
  post_address       String
  status             String             @default("none")
  content_recipients ContentRecipient[]
}

model ContentRecipient {
  id          Int        @id @default(autoincrement())
  content_id  Int?
  recipient   String
  method_id   Int
  created_at  DateTime   @default(now())
  user_id     Int
  content     Content?   @relation(fields: [content_id], references: [id])
  post_method PostMethod @relation(fields: [method_id], references: [id])
  user        User       @relation(fields: [user_id], references: [id])
}

model Question {
  id            Int      @id @default(autoincrement())
  text          String
  question_type String
  options       Json?
  is_archived   Boolean  @default(false)
  created_at    DateTime @default(now())
  created_by    Int
  updated_at    DateTime @updatedAt
  answers       Answer[]
  creator       User     @relation("CreatedQuestions", fields: [created_by], references: [id])
}

model Response {
  id           Int      @id @default(autoincrement())
  email        String
  submitted_at DateTime @default(now())
  answers      Answer[]
}

model Answer {
  id          Int      @id @default(autoincrement())
  question_id Int
  response_id Int
  answer_text String
  question    Question @relation(fields: [question_id], references: [id])
  response    Response @relation(fields: [response_id], references: [id])

  @@unique([response_id, question_id])
}
