generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  password   String
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  events     Event[]
  profile    Profile?
  questions  Question[] @relation("CreatedQuestions") // Relation for questions created by this user
}

model Profile {
  id              Int           @id @default(autoincrement())
  user_id         Int           @unique
  first_name      String
  last_name       String
  phone           String?
  organization_id Int?
  role_id         Int           @default(4)
  organization    Organization? @relation(fields: [organization_id], references: [id])
  role            Role          @relation(fields: [role_id], references: [id])
  user            User          @relation(fields: [user_id], references: [id])
}

model Organization {
  id                  Int           @id @default(autoincrement())
  name                String
  address             String
  subscription_status String?
  subscription_id     Int?
  last_purchase       DateTime?
  subscription        Subscription? @relation(fields: [subscription_id], references: [id])
  profiles            Profile[]
}

model Subscription {
  id            Int            @id @default(autoincrement())
  package_name  String
  cost          Float
  validity      Int
  organizations Organization[]
}

model Role {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  profiles Profile[]
}

model Event {
  id          Int       @id @default(autoincrement())
  time_span   Int
  name        String
  type        String?
  date_time   DateTime
  description String?
  user_id     Int
  contents    Content[]
  user        User      @relation(fields: [user_id], references: [id])
}

model Content {
  id                 Int                    @id @default(autoincrement())
  event_id           Int
  content_type       String
  text_content       String
  attachment         String?
  event              Event                  @relation(fields: [event_id], references: [id])
  content_recipients ContentRecipient[]
}

model PostMethod {
  id                 Int                @id @default(autoincrement())
  name               String             @unique
  post_address       String
  status             String             @default("none")
  content_recipients ContentRecipient[]
}

model ContentRecipient {
  id          Int         @id @default(autoincrement())
  content_id  Int?
  recipient   String
  method_id   Int
  created_at  DateTime    @default(now())
  content     Content?    @relation(fields: [content_id], references: [id])
  post_method PostMethod  @relation(fields: [method_id], references: [id])
}

model Question {
  id            Int       @id @default(autoincrement())
  text          String
  question_type String
  options       Json?
  is_archived   Boolean   @default(false)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  created_by    Int       // Foreign key to User who created the question
  creator       User      @relation("CreatedQuestions", fields: [created_by], references: [id])
  answers       Answer[]
}

model Response {
  id           Int       @id @default(autoincrement())
  email        String
  submitted_at DateTime  @default(now())
  answers      Answer[]
}

model Answer {
  id          Int       @id @default(autoincrement())
  question_id Int
  response_id Int
  answer_text String
  question    Question  @relation(fields: [question_id], references: [id])
  response    Response  @relation(fields: [response_id], references: [id])
  @@unique([response_id, question_id]) 
}